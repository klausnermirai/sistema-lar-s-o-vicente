rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for EVERYTHING securely
    match /{document=**} {
      allow read, write: if false;
    }

    // Mural Messages - Public Read for app frontend, Schema-Validated Create
    match /muralMessages/{messageId} {
      allow read: if true; 
      allow create: if
        request.resource.data.keys().hasAll(['institutionId', 'author', 'text', 'timestamp']) &&
        request.resource.data.institutionId is string && request.resource.data.institutionId.size() > 0 && request.resource.data.institutionId.size() <= 128 &&
        request.resource.data.author is string && request.resource.data.author.size() > 0 && request.resource.data.author.size() <= 128 &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000;
      allow update: if
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']) &&
         request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
         request.resource.data.likes is list && request.resource.data.likes.size() <= 2000);
      allow delete: if false; // Only admin via server
    }

    // Support Messages - Public Read, Schema-Validated Create
    match /support_messages/{messageId} {
      allow read: if true; 
      allow create: if
        request.resource.data.keys().hasAll(['institutionId', 'sender', 'text', 'role', 'createdAt']) &&
        request.resource.data.institutionId is string && request.resource.data.institutionId.size() > 0 && request.resource.data.institutionId.size() <= 128 &&
        request.resource.data.sender is string && request.resource.data.sender.size() > 0 && request.resource.data.sender.size() <= 128 &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000 &&
        (request.resource.data.role == 'user' || request.resource.data.role == 'support');
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']) &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000;
      allow delete: if false; // Only admin via server
    }

    // Companions - Secure collection for institution members
    match /companions/{companionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        request.resource.data.institutionId is string &&
        request.resource.data.name is string &&
        request.resource.data.role in ['tecnico', 'cuidador', 'acompanhante', 'homecare tecnico', 'homecare cuidador'];
    }
  }
}
